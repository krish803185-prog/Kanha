{
  "name": "kanha-spatial-os",
  "version": "1.0.0",
  "description": "KANHA // SPATIAL OS - Gesture-Driven Spatial Maritime Operating System (Vite + Three.js + WebSocket)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "relay": "node gesture-service/neural-relay.js",
    "start": "concurrently -k -n VITE,RELAY -c cyan,magenta \"vite\" \"node gesture-service/neural-relay.js\"",
    "start:lan": "concurrently -k -n VITE,RELAY -c cyan,magenta \"vite --mode lan\" \"node gesture-service/neural-relay.js\"",
    "postinstall": "node -e \"require('fs').cpSync('node_modules/@mediapipe/tasks-vision/wasm','public/mediapipe-wasm',{recursive:true})\"",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.1",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "concurrently": "^10.0.6",
    "vite": "^8.3.5"
  }
}
